# Save a copy as .env in the same folder. Open ONBOARDING.md for setup and examples.

# First chat — get a token from @BotFather and enter your numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Choose anthropic (Claude API key required) or local (install Ollama and create the model in ONBOARDING.md).
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
LOCAL_MODEL=mygg-chat
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-6

# Personalization. Use an IANA timezone, for example Europe/London.
USER_NAME=Alex
TIMEZONE=America/New_York
# Optional. Use your own numeric ID from ALLOWED_USER_IDS for scheduled briefings.
OWNER_CHAT_ID=

# Optional long-term memory. Install requirements/memory.txt, start Ollama and Qdrant,
# pull both models below, then set ENABLE_MEMORY=true and restart MyGG.
ENABLE_MEMORY=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MEMORY_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_HOST=localhost
QDRANT_PORT=6333
MEMORY_COLLECTION=mygg_memories

# Optional voice and meeting transcription. Install requirements/voice.txt first.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
TTS_VOICE=en-IE-EmilyNeural

# Optional Google access. Run python setup_calendar.py after adding credentials.json.
GOOGLE_ACCOUNT_LABEL=Personal Google account
# For another account set this to work, then run python setup_calendar.py work.
GOOGLE_EXTRA_ACCOUNTS=

# Optional weather. Set your city or share a Telegram location.
OPENWEATHER_API_KEY=
DEFAULT_LOCATION=New York, US

# Optional WhatsApp bridge. Generate a random secret as shown in ONBOARDING.md.
WHATSAPP_BRIDGE_PORT=8787
WHATSAPP_BRIDGE_SECRET=

# Optional WHOOP. Register this exact redirect URI, then run python whoop_auth.py.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8788/callback

# Advanced features. See ONBOARDING.md before enabling an external integration.
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_VISION=false
LOCAL_THINKING=off
# Optional: LLM_BACKEND_MAIN, LLM_BACKEND_SUBAGENT, LLM_BACKEND_MEETINGS,
# LLM_BACKEND_WHATSAPP can each select anthropic or local. Global local mode wins.
ENABLE_LOCAL_WEB=false
ENABLE_JINA_READER=false
JINA_API_KEY=
TTS_ENGINE=edge
TTS_EDGE_FALLBACK=false
TTS_DEVICE=cpu
GG_VOICE_LANG=en
# Private path to a reference recording you have permission to use. Blank uses the stock voice.
GG_VOICE_REF=
TTS_EXAGGERATION=0.5
# Owner-only /evolve command. Blank turns it off. Push only if origin points at your own fork.
EVOLVE_SAFEWORD=
EVOLVE_PUSH=false

# Optional operations. See OPERATIONS.md for sign-in, update and recovery commands.
MYGG_PIN_MODEL=false
MYGG_WARM_MEMORY=false

# Local WhatsApp device health and outgoing delivery port. The inbound port is above.
WHATSAPP_HEALTH_PORT=8786
# Optionally require a particular Gmail identity during authorization.
GOOGLE_ACCOUNT_EMAIL=
# For an additional account named work, set GOOGLE_ACCOUNT_WORK_EMAIL and GOOGLE_ACCOUNT_WORK_LABEL.

# Keep tasks on this computer or connect Google Tasks via the personal Google account.
TODO_BACKEND=sqlite
# Optional folders you choose. Leave blank on a new installation.
BOARD_DIR=
KNOWLEDGE_DIR=
# Optional existing vector index. Used in cloud mode with an OpenAI embedding API key.
KNOWLEDGE_QDRANT_URL=
KNOWLEDGE_COLLECTION=
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_EMBED_MODEL=text-embedding-3-large
OPENAI_API_KEY=
