# MyGG configuration — copy to `.env` and fill in.
# See ONBOARDING.md for step-by-step instructions on obtaining each value.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — without these, MyGG will not start.
# ─────────────────────────────────────────────────────────────────────────────

# Your Telegram bot's token from @BotFather. See ONBOARDING.md step 2.
TELEGRAM_BOT_TOKEN=

# Anthropic API key. Get one at https://console.anthropic.com (paid). Step 3.
ANTHROPIC_API_KEY=

# Comma-separated Telegram user IDs allowed to talk to your bot.
# Find your ID by sending /start to @userinfobot. Step 2.
# If left blank the bot will accept any user — DO NOT do this in production.
ALLOWED_USER_IDS=

# Your Telegram user ID (single number). The morning/evening briefings and
# meeting alerts are delivered here. Usually the same as ALLOWED_USER_IDS.
OWNER_CHAT_ID=

# How the assistant addresses you in the system prompt and tool descriptions.
USER_NAME=Alex


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — sensible defaults are used if unset.
# ─────────────────────────────────────────────────────────────────────────────

# IANA timezone for date/time rendering and heartbeat scheduling.
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Claude models. Sonnet is the default; Opus is used when you message with `!!`
# or run /opus. Override only if you want a different model alias.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_OPUS=claude-opus-4-6

# Display label for your Google account (shown in [brackets] when listing emails
# / calendars). Optional, defaults to "Personal Google account".
GOOGLE_ACCOUNT_LABEL=Personal Google account


# ─────────────────────────────────────────────────────────────────────────────
# MEMORY (mem0 + Ollama + Qdrant) — defaults work for the standard local setup.
# Step 4 + Step 5 in ONBOARDING.md.
# ─────────────────────────────────────────────────────────────────────────────

# Local Ollama URL. Leave alone unless Ollama is on a different host.
OLLAMA_BASE_URL=http://localhost:11434

# Local LLM used by mem0 for memory extraction. qwen3:8b is the default.
# Other reasonable choices: llama3.1:8b, mistral:7b.
OLLAMA_MEMORY_MODEL=qwen3:8b

# Embedding model. nomic-embed-text emits 768-dim vectors; if you change this,
# update the `embedding_model_dims` in tools.py to match.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant connection. Defaults assume the Docker container in ONBOARDING.md.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant collection name. Change this if you run multiple MyGG instances on
# the same Qdrant — each instance needs its own collection for isolation.
MEMORY_COLLECTION=mygg_memories


# ─────────────────────────────────────────────────────────────────────────────
# AUDIO — speech-to-text (Whisper) and text-to-speech (Edge TTS).
# Step 13 (optional voice) in ONBOARDING.md.
# ─────────────────────────────────────────────────────────────────────────────

# Whisper model size for voice-note transcription.
# - large-v3   = highest accuracy, ~3 GB VRAM, requires GPU
# - medium     = good balance, ~1.5 GB VRAM
# - small      = fast, CPU-friendly, lower accuracy
# - tiny.en    = English-only, very fast, basic accuracy
WHISPER_MODEL=large-v3

# `cuda` if you have an NVIDIA GPU, otherwise `cpu`.
WHISPER_DEVICE=cuda

# Edge TTS voice. Browse voices: `edge-tts --list-voices`.
TTS_VOICE=en-IE-EmilyNeural


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP — only set if you run the Node.js bridge in ./whatsapp-bridge.
# Optional. Step 13 in ONBOARDING.md.
# ─────────────────────────────────────────────────────────────────────────────

# Port the local HTTP receiver listens on (also used by the Node bridge).
WHATSAPP_BRIDGE_PORT=8787

# Shared secret between the Node bridge and the Python receiver.
# Generate any random string and paste it on both sides.
WHATSAPP_BRIDGE_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# WEATHER — only needed if you want the get_weather tool / weather in heartbeats.
# Optional. Sign up at https://openweathermap.org/api (free tier is fine).
# ─────────────────────────────────────────────────────────────────────────────

OPENWEATHER_API_KEY=

# Default city used when no location is shared yet. Format: "City, ST" or
# "City, CountryCode".
DEFAULT_LOCATION=New York, NY


# ─────────────────────────────────────────────────────────────────────────────
# WHOOP — only needed if you want fitness data from Whoop.
# Optional. Register a developer app at https://developer.whoop.com.
# Then run `python whoop_auth.py` once.
# ─────────────────────────────────────────────────────────────────────────────

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match the Redirect URI registered for your Whoop app.
# Default works with the localhost callback in whoop_auth.py.
WHOOP_REDIRECT_URI=http://localhost:8788/callback
